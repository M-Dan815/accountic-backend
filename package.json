{
  "name": "accountic-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Accountic backend — reconciliation, classification, trial balance and financial statements API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "prisma migrate deploy && tsx src/server.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx src/seed/index.ts",
    "eval:reference": "tsx scripts/eval-engine.ts",
    "test:classify": "tsx scripts/test-classify-case.ts",
    "test:extraction": "tsx scripts/test-statement-extraction.ts",
    "test:statement-only": "tsx scripts/test-statement-only-flow.ts",
    "eval:reference:legacy": "tsx scripts/eval-against-reference.ts",
    "test:reader": "tsx tests/reader.test.ts",
    "test:mapping": "tsx tests/mapping.test.ts",
    "test:validation": "tsx tests/validation.test.ts",
    "test:e2e": "tsx scripts/test-end-to-end.ts",
    "backfill:charts": "tsx scripts/backfill-charts.ts",
    "test": "npm run typecheck && npm run test:reader && npm run test:mapping && npm run test:validation && npm run test:extraction && npm run test:classify && npm run test:statement-only && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.632.0",
    "@aws-sdk/s3-request-presigner": "^3.632.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^7.0.0",
    "prisma": "^5.18.0",
    "puppeteer": "^25.11.0",
    "tsx": "^4.16.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4"
  }
}