# --- Database ---
DATABASE_URL="postgresql://accountic:accountic@localhost:5432/accountic?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# --- File storage ---
# If the S3_* vars below are not all set, the storage layer automatically
# falls back to local disk under ./uploads (see src/lib/storage.ts).
STORAGE_DRIVER="s3"            # "s3" | "local" — "s3" auto-falls-back if unconfigured
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                 # optional — for R2 / MinIO / other S3-compatible providers

# --- AI provider (swappable — see src/lib/ai-provider.ts) ---
AI_PROVIDER="none"             # "none" | "openai" | "deepseek" | "gemini"
AI_API_KEY=""
